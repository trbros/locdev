# Public GitHub repository used for links, issue forms, releases and clone commands.
# NEXT_PUBLIC values are embedded at build time; rebuild after changing this URL.
NEXT_PUBLIC_GITHUB_REPOSITORY_URL=https://github.com/trbros/locdev

# Canonical URL for metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://locdev.app

# Public operational information rendered by server pages (never put secrets here).
SITE_HOSTING_PROVIDER=Vercel
SITE_PRIVACY_CONTACT_URL=mailto:contact@triooo.com.br
# Optional: a verified description of the project's actual log retention settings.
SITE_HOSTING_LOG_RETENTION=
# Enable only after confirming the receiving mailbox and private reporting process.
SITE_SECURITY_REPORT_URL=mailto:security@triooo.com.br
SITE_SECURITY_REPORTING_CONFIRMED=true

# Optional: the version shown in the docs. Defaults to the app version in apps/desktop/package.json.
# NEXT_PUBLIC_APP_VERSION=

# Profile triooo on instagram and github profile
NEXT_PUBLIC_TRIOOO_INSTAGRAM=triooo_devs
NEXT_PUBLIC_TRIOOO_GITHUB=trbros
NEXT_PUBLIC_TRIOOO_SITE_URL=https://triooo.com.br
