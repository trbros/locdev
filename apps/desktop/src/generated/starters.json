          {
            "value": "react",
            "label": "React"
          },
          {
            "value": "svelte",
            "label": "Svelte"
          },
          {
            "value": "vue",
            "label": "Vue"
          },
          {
            "value": "livewire",
            "label": "Livewire"
          }
        ],
        "default": "react",
        "methods": [],
